# AgroFlet Platform API: the Fake API (json-server) that `npm run dev` serves at /api/v1 on its own domain, the same
# path the deployed application uses (see vite.config.js and the "Fake API" section in README.md).
VITE_AGROFLET_PLATFORM_API_URL=/api/v1
VITE_USERS_ENDPOINT_PATH=/users
VITE_VEHICLES_ENDPOINT_PATH=/vehicles
VITE_DRIVERS_ENDPOINT_PATH=/drivers
VITE_SHIPMENTS_ENDPOINT_PATH=/shipments
VITE_STATUS_CHANGES_ENDPOINT_PATH=/status-changes
VITE_LOCATIONS_ENDPOINT_PATH=/locations
VITE_POSITIONS_ENDPOINT_PATH=/positions
VITE_INCIDENTS_ENDPOINT_PATH=/incidents
VITE_NOTIFICATIONS_ENDPOINT_PATH=/notifications
VITE_PASSWORD_RESET_REQUESTS_ENDPOINT_PATH=/password-reset-requests
VITE_LANDING_PAGE_URL=https://agroflet.github.io/Agroflet-landing-page/

# PrimeUI (PrimeVue 5) license key. Students and academic projects qualify for the free Community License:
# https://primeui.dev/licenses/community — without a key PrimeVue shows an "Invalid PrimeUI License" notice.
VITE_PRIME_UI_LICENSE_KEY=
